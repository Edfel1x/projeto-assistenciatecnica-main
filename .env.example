# Copie este arquivo para .env e ajuste os valores conforme seu ambiente.
# O .env é ignorado pelo Git. Nunca commite credenciais reais.

# Banco de dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
# Padrão do projeto. Se usar o schema.sql original, troque para assistencia_tecnica.
DB_NAME=bcdados

# Servidor da API Flask
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# Origens permitidas no CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# URL da API usada pelo frontend Vite.
# Recomendado: deixe em branco. O navegador chama /api no mesmo endereço
# da página e o Vite repassa ao Flask por 127.0.0.1:5000 (evita IPv6 e
# funciona também quando o sistema é aberto por IP da rede).
# Se preferir chamar a API direto, use: VITE_API_URL=http://127.0.0.1:5000/api
VITE_API_URL=

# Testes de integração (opcional): banco EXCLUSIVO, criado por
# docs/sql/usuario_teste.sql; os testes recriam apenas as TABELAS.
# DB_NAME_TEST=bcdados_teste
